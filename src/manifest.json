{
  "$schema": "../node_modules/chrome-extension-manifest-json-schema/manifest/manifest.schema.v3.json",
  "manifest_version": 3,
  "author": "ZackSte",
  "name": "Make bing.com Redirects Transparent",
  "description": "Make bing.com search results transparent by setting the alt text to the original search result url.",
  "version": "0.0.0.1",
  "icons": {
    "16": "resources/16x16logo.png",
    "32": "resources/32x32logo.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://bing.com/*",
        "*://*.bing.com/*"
      ],
      "js": [
        "bingMonitor.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}